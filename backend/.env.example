# Set to "production" on Azure App Service (or any production deployment).
# When set, the app will refuse to start with an insecure default SECRET_KEY.
ENVIRONMENT=development

# Generate a real value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required in production - the app will fail to start without it.
SECRET_KEY=change-me-before-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Defaults to a local SQLite file if unset. For Azure deployment, set this to
# a managed database connection string instead, e.g. Azure Database for
# PostgreSQL Flexible Server:
#   postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/<dbname>?sslmode=require
DATABASE_URL=sqlite:///./app.db

# Optional: enables Gemini-powered mood analysis, journaling, affirmations,
# companion prompts, image interpretation, and chat features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Groq provider. When set, Groq is preferred in AI_PROVIDER=auto.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b
AI_PROVIDER=auto

# Optional: enables YouTube playlist suggestions.
YOUTUBE_API_KEY=

# Optional: override where uploaded user photos/audio are stored. Defaults to
# a local "uploads" folder next to main.py. On Azure App Service, point this
# at a mounted persistent file share if you're not using Blob Storage - see
# the comment above UPLOADS_DIR in main.py for details.
# UPLOADS_DIR=/home/uploads

# Optional: restrict CORS to specific origins (comma-separated). Defaults to
# "*" (any origin), which is fine for a mobile-only client but should be
# locked down if you ever add a web frontend.
# CORS_ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com
